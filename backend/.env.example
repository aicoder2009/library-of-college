# Lambda environment variables (set on the function — never commit real values).

# DynamoDB table name (partition key: pk, string).
TABLE=library-of-college

# Comma-separated Clerk issuers the API accepts — your instance's Frontend API URL,
# e.g. https://your-app.clerk.accounts.dev (or https://your.domain/__clerk in proxy mode).
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Comma-separated origins your frontend is served from (must match API Gateway CORS).
ALLOWED_ORIGINS=https://your.domain,http://localhost:8765

# Comma-separated Clerk user IDs with admin access (GET /waitlist). Optional.
ALLOWED_USER_ID=user_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk secret key — optional, only used to mirror waitlist signups into Clerk.
CLERK_SECRET_KEY=sk_test_xxx

# OpenAI key for the AI routes (server-side only).
OPENAI_API_KEY=sk-xxx
